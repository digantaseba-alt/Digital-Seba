/** Digital Seba Premium V4 - Google Apps Script backend */
var SS=SpreadsheetApp.getActiveSpreadsheet();
var SHEETS={sales:'Sales',expense:'DailyExpenses',purchase:'Purchases',fixed:'FixedExpenses'};
var HEADERS=['Transaction ID','Date','Customer Name','Mobile','Details','Note','Amount','Created At'];
var SETTINGS='Settings';
var DEFAULT_PIN='8899';
var RECOVERY_PIN='01816311351';
function json_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
function setupBusinessSheets(){Object.keys(SHEETS).forEach(function(k){var n=SHEETS[k],s=SS.getSheetByName(n);if(!s)s=SS.insertSheet(n);if(s.getLastRow()===0){s.getRange(1,1,1,HEADERS.length).setValues([HEADERS]);s.getRange(1,1,1,HEADERS.length).setFontWeight('bold').setBackground('#dff8f5')}s.setFrozenRows(1);s.getRange('A:A').setNumberFormat('@');s.getRange('B:B').setNumberFormat('@');s.getRange('D:D').setNumberFormat('@');s.getRange('G:G').setNumberFormat('#,##0.00');s.getRange('H:H').setNumberFormat('dd/MM/yy hh:mm AM/PM')});setupSettings_();return 'Setup complete'}
function setupSettings_(){var s=SS.getSheetByName(SETTINGS);if(!s)s=SS.insertSheet(SETTINGS);if(s.getLastRow()===0){s.getRange(1,1,3,2).setValues([['Key','Value'],['PIN',DEFAULT_PIN],['BusinessName','ডিজিটাল সেবা']]);s.getRange(1,1,1,2).setFontWeight('bold').setBackground('#dff8f5');s.hideSheet()}return s}
function setting_(key){var s=setupSettings_(),v=s.getDataRange().getDisplayValues();for(var i=1;i<v.length;i++)if(v[i][0]===key)return String(v[i][1]);return ''}
function setSetting_(key,val){var s=setupSettings_(),v=s.getDataRange().getDisplayValues();for(var i=1;i<v.length;i++)if(v[i][0]===key){s.getRange(i+1,2).setValue(String(val));return} s.appendRow([key,String(val)])}
function doGet(e){try{setupBusinessSheets();var a=String((e.parameter&&e.parameter.action)||'list');if(a==='ping')return json_({status:'success',serverTime:new Date().toISOString()});return json_({status:'success',data:listAll_(),businessName:setting_('BusinessName')||'ডিজিটাল সেবা'})}catch(err){return json_({status:'error',message:String(err.message||err)})}}
function doPost(e){var lock=LockService.getScriptLock();try{lock.waitLock(30000);setupBusinessSheets();var p=JSON.parse((e.postData&&e.postData.contents)||'{}');if(p.action==='login')return login_(p);if(p.action==='changePin')return changePin_(p);if(p.action==='add')return add_(p);return json_({status:'error',message:'Unknown action'})}catch(err){return json_({status:'error',message:String(err.message||err)})}finally{try{lock.releaseLock()}catch(_){}}}
function login_(p){var pin=String(p.pin||'').replace(/\D/g,'');return json_({status:pin===setting_('PIN')?'success':'error',message:pin===setting_('PIN')?'OK':'PIN সঠিক নয়'})}
function changePin_(p){var recovery=String(p.recoveryPin||'').replace(/\D/g,''),np=String(p.newPin||'').replace(/\D/g,'');if(recovery!==RECOVERY_PIN)return json_({status:'error',message:'Recovery PIN সঠিক নয়'});if(!/^\d{4,8}$/.test(np))return json_({status:'error',message:'নতুন PIN ৪-৮ সংখ্যার হতে হবে'});setSetting_('PIN',np);return json_({status:'success',message:'PIN আপডেট হয়েছে'})}
function isoToDisplay_(v){var m=String(v||'').match(/^(\d{4})-(\d{2})-(\d{2})$/);return m?m[3]+'/'+m[2]+'/'+m[1].slice(-2):''}
function displayToIso_(v){var m=String(v||'').match(/^(\d{2})\/(\d{2})\/(\d{2})$/);return m?'20'+m[3]+'-'+m[2]+'-'+m[1]:''}
function add_(p){var section=String(p.section||'');if(!SHEETS[section])return json_({status:'error',message:'Invalid section'});var id=String(p.transactionId||Utilities.getUuid()),date=String(p.date||''),amount=Number(p.amount||0);if(!/^\d{4}-\d{2}-\d{2}$/.test(date))return json_({status:'error',message:'Invalid date'});if(!(amount>0))return json_({status:'error',message:'Invalid amount'});var s=SS.getSheetByName(SHEETS[section]),last=s.getLastRow();if(last>1){var ids=s.getRange(2,1,last-1,1).getDisplayValues().map(function(r){return r[0]});if(ids.indexOf(id)!==-1)return json_({status:'success',duplicate:true,transactionId:id})}var now=new Date(),row=[id,isoToDisplay_(date),String(p.name||''),String(p.mobile||''),String(p.details||''),String(p.note||''),amount,now];s.insertRowBefore(2);s.getRange(2,1,1,row.length).setValues([row]);s.getRange(2,1).setNumberFormat('@');s.getRange(2,2).setNumberFormat('@');s.getRange(2,4).setNumberFormat('@');s.getRange(2,7).setNumberFormat('#,##0.00');s.getRange(2,8).setNumberFormat('dd/MM/yy hh:mm AM/PM');return json_({status:'success',transactionId:id,createdAt:now.toISOString()})}
function listAll_(){var tz=SS.getSpreadsheetTimeZone()||'Asia/Dhaka',all=[];Object.keys(SHEETS).forEach(function(section){var s=SS.getSheetByName(SHEETS[section]);if(!s||s.getLastRow()<2)return;var v=s.getRange(2,1,s.getLastRow()-1,HEADERS.length).getValues();v.forEach(function(r){var created=r[7] instanceof Date?r[7]:new Date(r[7]),rawDate=r[1] instanceof Date?Utilities.formatDate(r[1],tz,'yyyy-MM-dd'):String(r[1]||''),iso=/^\d{2}\/\d{2}\/\d{2}$/.test(rawDate)?displayToIso_(rawDate):rawDate;all.push({transactionId:String(r[0]||''),date:iso,section:section,name:String(r[2]||''),mobile:String(r[3]||''),details:String(r[4]||''),note:String(r[5]||''),amount:Number(r[6]||0),createdAt:isNaN(created.getTime())?'':created.toISOString(),createdAtDisplay:isNaN(created.getTime())?'':Utilities.formatDate(created,tz,'dd/MM/yy hh:mm a')})})});all.sort(function(a,b){return String(b.createdAt||b.date).localeCompare(String(a.createdAt||a.date))});return all}
